# Copy to `.env.local` and adjust for your environment.
#
# Base URL of the Products API. No trailing slash.
#
#   Local `dotnet run`      : http://localhost:5099
#   Local `docker compose`  : http://localhost:8080
#
# Vite only exposes variables prefixed with VITE_ to client code. That prefix is
# a deliberate safety rail: everything here is compiled into the bundle and is
# therefore public. Never put a secret in this file.
VITE_API_BASE_URL=http://localhost:5099
